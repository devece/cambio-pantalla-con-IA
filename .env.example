# Copia a .env y completa. NUNCA subas el .env al repositorio.
# En Vercel, estas variables se cargan en Project Settings > Environment Variables.

# Análisis de la captura de la radio y detección de faros (Claude con visión). Sin esta clave el sitio sigue funcionando:
# solo se salta el análisis. Créala en console.anthropic.com > API keys.
ANTHROPIC_API_KEY=
# Opcional: modelo usado para analizar capturas (por defecto claude-opus-5-5)
ANALYSIS_MODEL=

# Opcional: de dónde toma «Descargar la app con mi diseño» la APK base (por defecto, la última compilación en GitHub).
TABLERO_APK_URL=
