# Copia a .env y completa. NUNCA subas el .env al repositorio.
# En Vercel, estas variables se cargan en Project Settings > Environment Variables.

# Proyecto de Supabase propio de Tablero (no reutilices el de tus otras apps)
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Secreto largo y aleatorio para ligar licencias a radios (openssl rand -hex 32)
LICENSE_PEPPER=

# Análisis de la captura de la radio (Claude con visión). Sin esta clave el sitio sigue funcionando
# y solo guarda las medidas de la captura. Créala en console.anthropic.com > API keys.
ANTHROPIC_API_KEY=
# Opcional: modelo usado para analizar capturas (por defecto claude-opus-5-5)
ANALYSIS_MODEL=

# Clave del panel de administración (/admin.html). Elige una larga que solo tú sepas.
ADMIN_TOKEN=
