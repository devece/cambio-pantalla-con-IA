<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Velocidad y alerta de velocidad (solo mientras la pantalla de inicio está abierta). -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- Kilometraje automático: seguir sumando los km del GPS aunque Waze o Maps estén al frente (Android lo exige como servicio en primer plano). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <!-- Scanner OBD por Bluetooth: conectarse al adaptador que el usuario eligió (y solo a ese). -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- No todas las radios declaran Bluetooth; el scanner es opcional y la app debe poder instalarse igual. -->
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />

    <!-- Aviso de actualización: instalar la versión nueva de la propia app (Android pide la confirmación al usuario). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Ver todas las apps instaladas (el APK no se publica en Play Store): así las reconoce aunque la radio use otro tipo de icono. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <!-- Desde Android 11 hay que declarar qué apps queremos poder abrir desde el launcher. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.Tablero">

        <!-- HOME: es lo que permite elegir Tablero como pantalla de inicio de la radio. -->
        <!-- Cuenta los km recorridos con el GPS para los avisos de aceite y mantención. Lo enciende la pantalla de inicio. -->
        <service
            android:name=".OdometerService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- Permite mostrar la canción que suena (nombre, artista y carátula). El cliente lo autoriza una sola vez. -->
        <service
            android:name=".MediaListener"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Recibe la respuesta del instalador de Android durante una actualización. -->
        <receiver
            android:name=".Updater$UpdateReceiver"
            android:exported="false" />

        <!-- nosensor: usa la orientación de fábrica de la pantalla de la radio (horizontal en casi todas, vertical en las de 9,7"),
             sin girar con el sensor. Así una radio horizontal sigue igual que antes. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="nosensor"
            android:stateNotNeeded="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:screenOrientation="nosensor"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".WelcomeActivity"
            android:exported="false"
            android:screenOrientation="nosensor"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".DiagnosticActivity"
            android:exported="false"
            android:screenOrientation="nosensor" />
    </application>
</manifest>
